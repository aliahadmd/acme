{
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.venv",
      "!**/dist",
      "!**/.turbo",
      "!**/pnpm-lock.yaml",
      "!**/uv.lock",
      "!**/openapi.json",
      "!packages/api-client/src/client",
      "!apps/web/src/routeTree.gen.ts"
    ]
  }
}
