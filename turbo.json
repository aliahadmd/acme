{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "schema": {
      "cache": false,
      "outputs": ["../../packages/api-client/openapi.json"]
    },
    "generate": {
      "dependsOn": ["@acme/api#schema"],
      "cache": false
    }
  }
}
