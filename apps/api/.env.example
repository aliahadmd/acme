# apps/api runtime config — copy to `.env` (make install does this).
# Source of truth: app/core/config.py — full matrix in docs/environments.md.
# Prod: set these in Dokploy's Environment tab instead (never commit real secrets).

# --- Required ---
DATABASE_URL=postgresql+psycopg://acme:acme@localhost:5432/acme

# --- Object storage (S3-compatible; SeaweedFS in dev, see compose.yaml) ---
# Provider-neutral: same settings work for Garage / R2 / MinIO / AWS S3 in prod.
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=acme
S3_SECRET_KEY=acme-dev-secret
S3_BUCKET=acme-dev

# --- Transactional email over plain SMTP (Mailpit in dev, see compose.yaml) ---
# Prod: your MTA or relay — e.g. self-hosted Stalwart/Postal, or SES/Resend SMTP.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=dev@acme.local
SMTP_USE_TLS=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- Optional (defaults in app/core/config.py) ---
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# REDIS_URL=redis://localhost:6379/0
