# apps/web runtime config — copy to `.env` (make install does this).
# Source of truth: src/lib/env.ts — full matrix in docs/environments.md.

# --- Client (browser) — VITE_ vars are INLINED into the public bundle: no secrets here ---
VITE_API_BASE_URL=http://localhost:8000

# --- Server (SSR runtime, Node container) — never exposed to the browser ---
# In prod this is the INTERNAL docker-network URL (e.g. http://api:8000).
API_BASE_URL=http://localhost:8000
