# Root environment — consumed by `docker compose` for LOCAL DEV INFRA only.
# Copy to `.env` (make install does this). Real `.env` files are gitignored.
# Prod secrets live in Dokploy's Environment tab per service — see docs/environments.md.

# --- Postgres 17 + pgvector (local dev) ---
POSTGRES_USER=acme
POSTGRES_PASSWORD=acme
POSTGRES_DB=acme
POSTGRES_PORT=5432

# --- Redis (local dev) ---
REDIS_PORT=6379

# --- SeaweedFS: S3-compatible object storage (local dev) ---
# S3 API on S3_PORT, master UI on S3_UI_PORT. Credentials must match
# docker/seaweedfs/s3.json.
S3_PORT=8333
S3_UI_PORT=9333

# --- Mailpit (local dev catch-all SMTP + UI on :8025) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
